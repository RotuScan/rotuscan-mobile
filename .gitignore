# Dependências em qualquer pasta
node_modules/
**/node_modules/

# Variáveis de Ambiente (Segurança Crítica)
.env
.env.*
**/.env

# Arquivos temporários de Upload do OCR (Mantém a pasta, ignora as fotos)
server/uploads/*
!server/uploads/.gitkeep

# Cache do Expo e React Native
.expo/
**/.expo/
dist/
web-build/

# Configurações pessoais de editor e Sistema Operacional
.vscode/
**/.vscode/
.DS_Store
Thumbs.db
*.log